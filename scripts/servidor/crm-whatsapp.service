[Unit]
Description=CRM de WhatsApp con IA
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=crm
Group=crm
WorkingDirectory=__CARPETA__
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=__CARPETA__/.herramientas/node/bin/node __CARPETA__/node_modules/next/dist/bin/next start -p 3000 -H 127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
