# Configuración de tu CRM. Las claves las pegas en el CRM al abrirlo: no hace falta escribirlas aquí.
PUERTO=8000

# Opcional: guardar los datos en Supabase en vez de en este ordenador (carpeta datos/).
# En tu proyecto de Supabase → Connect → Session pooler. Cambia [YOUR-PASSWORD] por la contraseña de la
# base de datos. Si lleva símbolos como @, # o /, cámbialos por su código (%40, %23, %2F) o pon otra
# contraseña sin ellos. Las tablas se crean solas la primera vez.
# SUPABASE_DB_URL=

# Opcional: un dominio fijo de tu cuenta de ngrok. Vacío usa el de tu cuenta.
# NGROK_DOMAIN=

# Opcional: si ya publicas el CRM con tu propio túnel, su dirección (https://…). Con ella no se abre ngrok
# y Meta avisa a esa dirección.
# CRM_URL_PUBLICA=

# Modo servidor: lo pone el instalador del servidor.
# CRM_DOMINIO=

# Valores antiguos que siguen funcionando (Ajustes tiene prioridad): NOMBRE_NEGOCIO, PLANTILLA,
# PLANTILLA_IDIOMA, MODELO, TELEFONO_COMERCIAL. Una instalación nueva no los necesita.
