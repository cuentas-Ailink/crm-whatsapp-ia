# Configuración del servidor de pruebas (node scripts/servidor-pruebas.mjs), no de tu CRM.
# Para probar sin claves reales: Meta y Claude los simula scripts/simulador.mjs. Estos valores son
# de mentira a propósito: no son claves y no sirven fuera de las pruebas.
# Sin PLANTILLA: como una instalación nueva, la bienvenida es solicitud_general.
ANTHROPIC_API_KEY=clave-de-prueba
ANTHROPIC_BASE_URL=http://127.0.0.1:8099/v1
MODELO=claude-haiku-5-5
GRAPH_BASE_URL=http://127.0.0.1:8099/graph
WHATSAPP_TOKEN=token-de-prueba
WHATSAPP_PHONE_NUMBER_ID=123456789
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321
META_APP_SECRET=secreto-de-prueba
WEBHOOK_VERIFY_TOKEN=verifica-de-prueba
NGROK_DOMAIN=
NOMBRE_NEGOCIO=Estudio de reformas
PUERTO=8000
# Postgres embebido en la carpeta bd-pruebas/: las pruebas nunca tocan Supabase.
BD_LOCAL=bd-pruebas
# Transcripción simulada y un comercial ficticio: los avisos llegan al simulador.
GEMINI_API_KEY=clave-de-prueba
TRANSCRIPCION_BASE_URL=http://127.0.0.1:8099/v1beta
TELEFONO_COMERCIAL=34600999999
